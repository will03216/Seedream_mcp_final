# BytePlus ModelArk bearer token — required for all image generation
ARK_API_KEY=your-modelark-api-key

# BytePlus IAM credentials — required ONLY to upload local reference images to TOS.
# Plain text-to-image (and public-URL references) do not need these.
ARK_AK=your-iam-access-key
ARK_SK=your-iam-secret-key

# Optional: default model + TOS bucket
# SEEDREAM_MODEL=seedream-4-5-251128       # or seedream-5-0-260128 (5.0 Lite)
# SEEDREAM_TOS_BUCKET=your-bucket
# SEEDREAM_TOS_REGION=ap-southeast-1

# Optional tuning
# SEEDREAM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDREAM_SUBMIT_TIMEOUT=600
# SEEDREAM_DOWNLOAD_TIMEOUT=120
# SEEDREAM_MAX_RETRIES=3
# SEEDREAM_DEBUG_RAW=0

# HTTP server mode (set to "sse" for Docker / hosted deployments)
# MCP_TRANSPORT=stdio
# PORT=8000
# MCP_AUTH_TOKEN=your-strong-random-token
